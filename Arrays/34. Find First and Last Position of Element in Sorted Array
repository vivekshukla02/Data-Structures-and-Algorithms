class Solution {
    public int[] searchRange(int[] arr, int target) {
        int first = -1;
        int last = -1;
        for(int idx=0; idx<arr.length;idx++){
            if(arr[idx]==target){
                last = idx
                 if(first ==-1){
                first = idx;
            }
            }
           
        }
        int []ans = {first,last};
        return ans;
    }
}
