class Solution {
    List<List<Integer>>ways;
    public void printWay(int[]coins , int idx , int target , List<Integer>output){
        if(target<0) return;
      if(idx==coins.length){
         if(target==0){
            ways.add(new ArrayList<>(output));

         }
         return;
      }





        output.add(coins[idx]);
        printWay(coins , idx+1 , target-coins[idx], output);
        output.remove(output.size()-1);

        if(output.size()>0 && output.get(output.size()-1)==coins[idx])
            return;
        printWay(coins , idx+1 ,target, output);
        
    }
    public List<List<Integer>> combinationSum2(int[] coins, int target) {
               Arrays.sort(coins);
               ways = new ArrayList<>();
               printWay(coins , 0 , target , new ArrayList<>());
               return ways;
        }
}
